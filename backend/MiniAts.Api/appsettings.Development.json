{
  // Development overrides – fill in real values locally, never commit this file.
  // This file is listed in .gitignore via **/.env.* exclusion (keep as .json.example).
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "ConnectionStrings": {
    "Supabase": "Host=YOUR_DB_HOST;Port=5432;Database=postgres;Username=postgres;Password=YOUR_DB_PASSWORD;SSL Mode=Require"
  },
  "Supabase": {
    "Url": "https://YOUR_PROJECT.supabase.co",
    "JwtSecret": "YOUR_SUPABASE_JWT_SECRET",
    "ServiceRoleKey": "YOUR_SUPABASE_SERVICE_ROLE_KEY"
  },
  "AiService": {
    "BaseUrl": "http://localhost:8001",
    "ApiKey": "local-dev-key"
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:5173"
  }
}
