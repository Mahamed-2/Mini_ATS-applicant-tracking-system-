{
  // Default runtime config – contains no secrets.
  // Secrets are provided via appsettings.Development.json or Railway env vars.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    // Postgres connection to Supabase – override via environment variable ConnectionStrings__Supabase.
    "Supabase": "Host=PLACEHOLDER;Port=5432;Database=postgres;Username=postgres;Password=PLACEHOLDER;SSL Mode=Require"
  },
  "Supabase": {
    // Supabase project URL – used to build the JWT issuer URL.
    "Url": "https://PLACEHOLDER.supabase.co",
    // JWT secret used to validate Supabase access tokens; never commit the real value.
    "JwtSecret": "PLACEHOLDER",
    // Service role key for Supabase Auth Admin API calls; server-side only.
    "ServiceRoleKey": "PLACEHOLDER"
  },
  "AiService": {
    // Base URL of the Python FastAPI AI service (local: http://localhost:8001).
    "BaseUrl": "http://localhost:8001",
    // Shared internal API key sent as X-AI-Service-Key header.
    "ApiKey": "PLACEHOLDER"
  },
  "Cors": {
    // Comma-separated allowed origins; include Vercel URL and local dev server.
    "AllowedOrigins": "http://localhost:5173"
  }
}
