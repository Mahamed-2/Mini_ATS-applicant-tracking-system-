# Ignore every root entry by default.
# This keeps accidental local junk out of the prototype repository.
/*

# Re-include only the files and folders required for the web prototype.
!/.gitignore
!/README.md
!/docs/
!/backend/
!/frontend/
!/supabase/
!/.claude/
!/scripts/
!/railway.toml
!/.github/

# Claude Code local settings stay private per developer.
.claude/settings.local.json

# Environment secrets must never be committed, but examples are fine.
**/.env
**/.env.*
!**/.env.example

# Node / Vite / frontend build artifacts.
**/node_modules/
**/dist/
**/build/
**/.vite/
**/coverage/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# .NET build artifacts.
**/bin/
**/obj/
**/out/
**/*.user
**/*.suo
**/*.userprefs
**/.dotnet/

# Python build/runtime artifacts.
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.venv/
**/venv/
**/env/
**/*.egg-info/

# Supabase local CLI artifacts – keep committed migrations/config.
**/.supabase/
supabase/.branches/
supabase/.temp/

# OS/editor noise.
.DS_Store
Thumbs.db
.idea/
.vscode/
!.vscode/extensions.json
*.swp
*.swo
*.tsbuildinfo
